        <pipeline
          version="1">
          <components>
            <component
              refId="Package\DF Fact Ventas\Actualizar Data Mart Fact Ventas"
              componentClassID="Microsoft.OLEDBCommand"
              contactInfo="OLE DB Command;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;2"
              description="Runs an SQL statement for each row in a data flow. For example, call a 'new employee setup' stored procedure for each row in the 'new employees' table. Note: running an SQL statement for each row of a large data flow may take a long time."
              name="Actualizar Data Mart Fact Ventas"
              usesDispositions="true"
              version="2">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">UPDATE [DATAMART_NORTHWND].[dbo].[Fact_Ventas]
SET [DATAMART_NORTHWND].[dbo].[Fact_Ventas].Ventas_Monto = SVEN.Ventas_Monto,
	[DATAMART_NORTHWND].[dbo].[Fact_Ventas].Ventas_Unidades = SVEN.Ventas_Unidades,
	[DATAMART_NORTHWND].[dbo].[Fact_Ventas].Ventas_PUnitario = SVEN.Ventas_PUnitario,
	[DATAMART_NORTHWND].[dbo].[Fact_Ventas].Ventas_Descuento = SVEN.Ventas_Descuento
FROM [DATAMART_NORTHWND].[dbo].[Fact_Ventas]
JOIN
	[DATAMART_NORTHWND].[dbo].[Dim_Empleado] AS DEMP
	ON [DATAMART_NORTHWND].[dbo].[Fact_Ventas].Empleado_SKey = DEMP.Empleado_SKey
JOIN 
	[STAGE_NORTHWND].[dbo].[Stage_Empleado] AS SEMP
	ON SEMP.Empleado_Codigo = DEMP.Empleado_Codigo
JOIN
	[DATAMART_NORTHWND].[dbo].[Dim_Producto] AS DPRO
	ON [DATAMART_NORTHWND].[dbo].[Fact_Ventas].Producto_SKey = DPRO.Producto_SKey
JOIN
	[STAGE_NORTHWND].[dbo].[Stage_Producto] AS SPRO
	ON DPRO.Producto_Codigo = SPRO.Producto_Codigo
JOIN
	[DATAMART_NORTHWND].[dbo].[Dim_Cliente] AS DCLI
	ON [DATAMART_NORTHWND].[dbo].[Fact_Ventas].Cliente_SKey = DCLI.Cliente_SKey
JOIN
	[STAGE_NORTHWND].[dbo].[Stage_Cliente] AS SCLI
	ON DCLI.Cliente_Codigo = SCLI.Cliente_Codigo
JOIN
	[DATAMART_NORTHWND].[dbo].[Dim_Tiempo] AS MTIE
	ON [DATAMART_NORTHWND].[dbo].[Fact_Ventas].Tiempo_Skey = MTIE.Tiempo_Skey
JOIN
	[STAGE_NORTHWND].[dbo].[Stage_Tiempo] AS STIE
	ON MTIE.Tiempo_FechaActual = STIE.Tiempo_FechaActual
JOIN
	[STAGE_NORTHWND].[dbo].[Stage_Ventas] AS SVEN
	ON [DATAMART_NORTHWND].[dbo].[Fact_Ventas].Ventas_NOrden = SVEN.Ventas_NOrden
WHERE
([DATAMART_NORTHWND].[dbo].[Fact_Ventas].Cliente_SKey = ? AND 
[DATAMART_NORTHWND].[dbo].[Fact_Ventas].Empleado_SKey = ? AND 
[DATAMART_NORTHWND].[dbo].[Fact_Ventas].Producto_SKey = ? AND 
[DATAMART_NORTHWND].[dbo].[Fact_Ventas].Tiempo_SKey = ? AND
[DATAMART_NORTHWND].[dbo].[Fact_Ventas].Ventas_NOrden = ?)</property>
                <property
                  dataType="System.Int32"
                  description="Specifies the column code page to use when code page information is unavailable from the data source."
                  name="DefaultCodePage">1252</property>
              </properties>
